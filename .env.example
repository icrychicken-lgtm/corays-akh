# ─────────────────────────────────────────────────────────────
#  Nova Community Bot – Umgebungsvariablen
#  Kopiere diese Datei nach `.env` und fülle die Werte aus.
#  Secrets gehören NUR in diese Datei – niemals in den Code.
# ─────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────
# https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=
# OAuth2 → Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Komma-separierte Discord-User-IDs, die Zugriff aufs Owner-Panel haben
OWNER_IDS=
# Optional: Guild-ID für sofortige Slash-Command-Synchronisation während der Entwicklung
DEV_GUILD_ID=
# Presence-Intent aktivieren (für Online-Zähler + Games im Profil). Muss im Dev-Portal freigeschaltet sein.
ENABLE_PRESENCE_INTENT=true

# ── Dashboard ────────────────────────────────────────────────
# Öffentliche Basis-URL des Dashboards (ohne Slash am Ende).
# Die Redirect-URL <DASHBOARD_URL>/auth/callback muss im Dev-Portal unter OAuth2 → Redirects eingetragen sein.
DASHBOARD_URL=http://localhost:8080
WEB_HOST=0.0.0.0
WEB_PORT=8080
# true, sobald das Dashboard über HTTPS läuft
COOKIE_SECURE=false
# Mindestens 32 zufällige Zeichen:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet-Key zur Verschlüsselung gespeicherter API-Keys:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Datenbank / Cache ────────────────────────────────────────
# PostgreSQL (Produktion):   postgresql+asyncpg://nova:passwort@db:5432/nova
# SQLite (nur lokale Tests): sqlite+aiosqlite:///./data/nova.db
DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5432/nova
# Optional – ohne Redis wird ein In-Memory-Cache verwendet
REDIS_URL=

# ── Logging / Backups ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
BACKUP_DIR=./backups
# Automatische Backups alle X Stunden (0 = aus)
BACKUP_INTERVAL_HOURS=24
# Wie viele automatische Backups pro Server behalten werden
BACKUP_KEEP=14

# ── Integrationen (globale Defaults) ─────────────────────────
# Können pro Server im Dashboard überschrieben werden (dort verschlüsselt gespeichert).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Intervall, in dem Streams geprüft werden (Sekunden, min. 60)
STREAM_POLL_SECONDS=90

# ── Sonstiges ────────────────────────────────────────────────
DEFAULT_LOCALE=de
BOT_NAME=Nova

# ── Auto-Update ──────────────────────────────────────────────
# Beim Start holt der Bot die neueste Version aus diesem GitHub-Repo (besitzer/repo).
# Token: GitHub → Settings → Developer settings → Fine-grained tokens → nur dieses Repo, „Contents: Read-only“.
UPDATE_REPO=
UPDATE_TOKEN=
UPDATE_BRANCH=main
